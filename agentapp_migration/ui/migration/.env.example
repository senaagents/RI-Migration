# Local Avinash, safe default for migration UI testing.
VITE_MIGRATION_DEV_PORT=5175
VITE_FRAPPE_BASE_URL=http://avinash.localhost:8081
VITE_FRAPPE_SITE_NAME=avinash.localhost

# To point at another local site, override these values in .env.development
# or inline when starting Vite, for example:
# VITE_FRAPPE_BASE_URL=http://dev.localhost:8001 VITE_FRAPPE_SITE_NAME=dev.localhost pnpm dev
